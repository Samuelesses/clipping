# Copy this file to .env.local and fill in your key.
# This app runs entirely on your own machine - the key is only used to call
# OpenAI from your local Next.js server, it is never sent anywhere else.

# Required: used for transcription fallback (Whisper, when a video has no
# captions) and for picking the best moments from the transcript.
OPENAI_API_KEY=

# Optional: override the model used to pick highlights from the transcript.
# Defaults to gpt-5.1. Cheaper options:
#   gpt-5.1-mini / gpt-4.1-mini - cheaper, still solid at this task
#   gpt-5.1-nano / gpt-4.1-nano - cheapest, fine for short/simple videos
# OPENAI_MODEL=gpt-5.1-mini

# Only needed if yt-dlp fails with "Sign in to confirm you're not a bot" (a YouTube bot
# check - common from a server/VM, but can happen on any connection). Easiest fix: export
# a cookies.txt from a browser you're logged into YouTube with (e.g. via the "Get
# cookies.txt LOCALLY" extension) and drop the file at the root of this project, named
# exactly `cookies.txt` - it's auto-detected, no env var needed (and .gitignore'd so it's
# never committed). See https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
#
# The two vars below are only for a non-default location, or reading cookies live from an
# installed browser instead. YTDLP_COOKIES_FILE takes precedence if both are set, and
# either takes precedence over an auto-detected ./cookies.txt.
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Optional: only needed to use the "Post to TikTok" button. Create a TikTok developer
# app with the Login Kit and Content Posting API products added (see README's TikTok
# section for the full walkthrough, including the private-only limitation for an
# unaudited app), then paste its client key/secret here.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Optional: only needed if this app isn't running at the default http://localhost:3000
# (e.g. a different port) - must exactly match a redirect URI registered on the TikTok
# app, ending in /api/tiktok/callback.
# TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback
