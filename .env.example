# Copy this file to .env.local and fill in your keys.
# This app runs entirely on your own machine - keys are only used to call
# OpenAI (transcription) and Anthropic (highlight selection) from your
# local Next.js server, they are never sent anywhere else.

# Required: used to transcribe the downloaded audio (Whisper API).
OPENAI_API_KEY=

# Required: used to read the transcript and pick the best moments.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for highlight selection.
# Defaults to claude-opus-5 (best quality, highest cost). Cheaper options:
#   claude-sonnet-5   - much cheaper, still strong at this task
#   claude-haiku-4-5  - cheapest, fine for short/simple videos
# ANTHROPIC_MODEL=claude-sonnet-5
